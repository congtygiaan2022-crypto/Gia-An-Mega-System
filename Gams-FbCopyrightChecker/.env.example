# ────────────────────────────────────────
# FB Copyright Checker — Environment Variables
# Copy file này thành .env và điền giá trị thực
# ────────────────────────────────────────

# Anthropic API key — lấy tại https://console.anthropic.com/
# Bắt buộc nếu muốn dùng Claude AI classifier (Tầng 2)
# Nếu bỏ trống, tool sẽ fallback về keyword matching
ANTHROPIC_API_KEY=sk-ant-...

# (Tùy chọn) Telegram webhook để nhận thông báo real-time
# Tạo bot qua @BotFather, lấy token và chat_id
# TELEGRAM_BOT_TOKEN=123456789:ABCdef...
# TELEGRAM_CHAT_ID=-100123456789
