# Ignore everything at the root level only
/*

# Whitelist root git files and installer folder
!/.gitignore
!/PushToGit.cmd
!/AutoUpdate - Gia-An-Mega-System/

# Whitelist all project directories at root
!/Gams-*/

# Within whitelisted folders, ignore local runtime, database, venv, and profile files
**/venv/
**/.venv/
**/env/
**/ENV/
**/node_modules/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.accdb
**/*.mdb
**/cookies.txt
**/cookies/
**/sessions/
**/*.session
**/*.tokens
**/.env
**/logs/
**/*.log
**/config.json
**/settings.json
**/token.json
**/credentials.json

# Exclude Chrome browser profile patterns and Caches recursively
**/profile/
**/profiles/
**/*profile*/
**/*cookie*/
**/Cache/
**/Cache_Data/
**/chrome/

# Exclude all executable binaries, dynamic libraries, and large archives
**/*.exe
**/*.dll
**/*.zip
**/*.rar
**/*.7z
**/ffmpeg
